GEMINI_API_KEY=your_gemini_api_key_here

# Opcionais (têm valor padrão sensato em config.py) — só defina se quiser mudar.
# SECRET_KEY=troque-por-um-valor-aleatorio-em-producao
# SLA_CHECK_INTERVAL_MINUTOS=60

# Em produção (Railway), aponte estes dois para dentro do Volume persistente
# que você montar no serviço (ex.: um volume montado em /data):
# DATABASE_PATH=/data/qa_audit.db
# UPLOAD_FOLDER=/data/uploads
# Sem isso, o banco e os documentos enviados ficam no disco efêmero do
# container e são perdidos a cada novo deploy/reinício.